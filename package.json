{
  "name": "@stellar-expert/contract-wasm-interface-parser",
  "version": "6.0.0",
  "description": "Contract interface metadata parser for binary WASM",
  "author": "orbitlens <orbit@stellar.expert>",
  "license": "MIT",
  "type": "module",
  "main": "lib/wasmparser.js",
  "module": "src/index.js",
