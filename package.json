  "repository": {
    "type": "git",
    "url": "git+https://github.com/stellar-expert/contract-wasm-interface-parser.git"
  },
  "scripts": {
    "prepublish": "rollup -c",
    "test": "jest"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=17"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "1.0.0",
    "rollup": "4.62.2",
    "jest": "30.4.2"
  },
  "files": [
    "lib",
    "src",
    "src/index.d.ts",
    "!src/bundle.js"
  ]
}